<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - AdminLTE</title>
    <link rel="stylesheet" href="~/css/site.css" />
    <script src="https://unpkg.com/lucide@latest"></script>
</head>
<body class="bg-gray-100 font-sans text-gray-800 antialiased">
    @{
        var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
    }

    <div class="flex h-screen overflow-hidden">

        <!-- Sidebar -->
        <aside class="w-64 bg-slate-800 text-gray-300 flex flex-col flex-shrink-0">
            <div class="h-14 flex items-center px-4 border-b border-slate-700 font-semibold text-lg text-white">
                <span class="bg-blue-600 rounded-full w-8 h-8 flex items-center justify-center mr-2 text-sm font-bold">A</span>
                AdminLTE 3
            </div>

            <div class="flex items-center gap-3 p-4 border-b border-slate-700">
                <div class="w-9 h-9 rounded-full bg-slate-600 flex items-center justify-center text-white font-bold text-sm">AP</div>
                <span class="text-sm font-medium text-white">Alexander Pierce</span>
            </div>

            <nav class="flex-1 overflow-y-auto p-3 space-y-1 text-sm">
                <!-- Dashboard -->
                <a href="/Home/Index" class="flex items-center gap-3 px-3 py-2 rounded-lg transition @(currentAction == "Index" ? "bg-blue-600 text-white font-medium" : "hover:bg-slate-700 text-gray-300")">
                    <i data-lucide="gauge" class="w-4 h-4"></i> Dashboard
                </a>

                <!-- Widgets -->
                <a href="/Home/Widgets" class="flex items-center gap-3 px-3 py-2 rounded-lg transition @(currentAction == "Widgets" ? "bg-blue-600 text-white font-medium" : "hover:bg-slate-700 text-gray-300")">
                    <i data-lucide="grid" class="w-4 h-4"></i> Widgets
                    <span class="ml-auto bg-red-600 text-xs px-1.5 py-0.5 rounded text-white font-semibold">New</span>
                </a>

                <!-- Charts -->
                <a href="/Home/Charts" class="flex items-center gap-3 px-3 py-2 rounded-lg transition @(currentAction == "Charts" ? "bg-blue-600 text-white font-medium" : "hover:bg-slate-700 text-gray-300")">
                    <i data-lucide="pie-chart" class="w-4 h-4"></i> Charts
                </a>

                <!-- Tables -->
                <a href="/Home/Tables" class="flex items-center gap-3 px-3 py-2 rounded-lg transition @(currentAction == "Tables" ? "bg-blue-600 text-white font-medium" : "hover:bg-slate-700 text-gray-300")">
                    <i data-lucide="table" class="w-4 h-4"></i> Tables
                </a>
            </nav>
        </aside>

        <!-- Main Content Area -->
        <div class="flex-1 flex flex-col min-w-0 overflow-y-auto">
            <header class="h-14 bg-white border-b border-gray-200 flex items-center justify-between px-6">
                <div class="flex items-center space-x-4 text-sm text-gray-600">
                    <button class="hover:text-black"><i data-lucide="menu" class="w-5 h-5"></i></button>
                    <a href="/Home/Index" class="hover:text-black">Home</a>
                    <a href="#" class="hover:text-black">Contact</a>
                </div>
                <div class="flex items-center space-x-4 text-gray-500">
                    <button class="hover:text-black relative">
                        <i data-lucide="bell" class="w-5 h-5"></i>
                        <span class="absolute -top-1 -right-1 bg-yellow-500 text-white text-[10px] w-4 h-4 rounded-full flex items-center justify-center font-bold">3</span>
                    </button>
                    <button class="hover:text-black"><i data-lucide="maximize-2" class="w-5 h-5"></i></button>
                </div>
            </header>

            <main class="p-6">
                @RenderBody()
            </main>
        </div>
    </div>

    <script>lucide.createIcons();</script>
</body>
</html>