@{
    ViewData["Title"] = "Tables";
}
<h1 class="text-2xl font-bold text-gray-800 mb-4">Data Tables</h1>
<div class="bg-white p-6 rounded shadow overflow-x-auto">
    <table class="w-full text-left text-sm text-gray-500">
        <thead class="bg-gray-50 text-xs uppercase text-gray-700">
            <tr>
                <th class="px-4 py-2">ID</th>
                <th class="px-4 py-2">Item</th>
                <th class="px-4 py-2">Status</th>
            </tr>
        </thead>
        <tbody>
            <tr class="border-b">
                <td class="px-4 py-2 font-medium text-gray-900">1001</td>
                <td class="px-4 py-2">Order Batch A</td>
                <td class="px-4 py-2 text-green-600">Completed</td>
            </tr>
            <tr class="border-b">
                <td class="px-4 py-2 font-medium text-gray-900">1002</td>
                <td class="px-4 py-2">Order Batch B</td>
                <td class="px-4 py-2 text-yellow-600">Pending</td>
            </tr>
        </tbody>
    </table>
</div>