@model AdminDashboard.Models.DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
}

<div class="flex items-center justify-between mb-6">
    <h1 class="text-2xl font-bold text-gray-800">Dashboard</h1>
    <div class="text-xs text-gray-500">
        <span class="text-blue-600 hover:underline cursor-pointer">Home</span> / Dashboard v1
    </div>
</div>

<!-- 4 AdminLTE Metric Cards -->
<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4 mb-6">
    <!-- Total Products -->
    <div class="bg-cyan-600 rounded shadow text-white flex flex-col justify-between overflow-hidden relative">
        <div class="p-4 flex justify-between items-start">
            <div>
                <h3 class="text-3xl font-bold">@Model.NewOrders</h3>
                <p class="text-xs opacity-90 mt-1">Total Products</p>
            </div>
            <i data-lucide="shopping-bag" class="w-12 h-12 text-white/20 absolute right-3 top-3"></i>
        </div>
        <a href="#" class="bg-cyan-700/60 hover:bg-cyan-700/90 py-1 px-4 text-xs flex items-center justify-center gap-1 transition">
            More info <i data-lucide="arrow-right-circle" class="w-3.5 h-3.5"></i>
        </a>
    </div>

    <!-- Bounce Rate -->
    <div class="bg-emerald-600 rounded shadow text-white flex flex-col justify-between overflow-hidden relative">
        <div class="p-4 flex justify-between items-start">
            <div>
                <h3 class="text-3xl font-bold">@Model.BounceRate<sup class="text-lg font-medium">%</sup></h3>
                <p class="text-xs opacity-90 mt-1">Bounce Rate</p>
            </div>
            <i data-lucide="bar-chart-2" class="w-12 h-12 text-white/20 absolute right-3 top-3"></i>
        </div>
        <a href="#" class="bg-emerald-700/60 hover:bg-emerald-700/90 py-1 px-4 text-xs flex items-center justify-center gap-1 transition">
            More info <i data-lucide="arrow-right-circle" class="w-3.5 h-3.5"></i>
        </a>
    </div>

    <!-- User Registrations -->
    <div class="bg-amber-500 rounded shadow text-white flex flex-col justify-between overflow-hidden relative">
        <div class="p-4 flex justify-between items-start">
            <div>
                <h3 class="text-3xl font-bold">@Model.UserRegistrations</h3>
                <p class="text-xs opacity-90 mt-1">User Registrations</p>
            </div>
            <i data-lucide="user-plus" class="w-12 h-12 text-white/20 absolute right-3 top-3"></i>
        </div>
        <a href="#" class="bg-amber-600/60 hover:bg-amber-600/90 py-1 px-4 text-xs flex items-center justify-center gap-1 transition">
            More info <i data-lucide="arrow-right-circle" class="w-3.5 h-3.5"></i>
        </a>
    </div>

    <!-- Unique Visitors -->
    <div class="bg-rose-600 rounded shadow text-white flex flex-col justify-between overflow-hidden relative">
        <div class="p-4 flex justify-between items-start">
            <div>
                <h3 class="text-3xl font-bold">@Model.UniqueVisitors</h3>
                <p class="text-xs opacity-90 mt-1">Unique Visitors</p>
            </div>
            <i data-lucide="pie-chart" class="w-12 h-12 text-white/20 absolute right-3 top-3"></i>
        </div>
        <a href="#" class="bg-rose-700/60 hover:bg-rose-700/90 py-1 px-4 text-xs flex items-center justify-center gap-1 transition">
            More info <i data-lucide="arrow-right-circle" class="w-3.5 h-3.5"></i>
        </a>
    </div>
</div>

<!-- Chart & Map Placeholders -->
<div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-6">
    <div class="bg-white rounded border border-gray-200 shadow-sm p-4">
        <div class="flex justify-between items-center pb-3 border-b border-gray-100">
            <h2 class="font-semibold text-gray-700 flex items-center gap-2 text-sm">
                <i data-lucide="trending-up" class="w-4 h-4 text-gray-500"></i> Sales
            </h2>
            <div class="flex gap-1">
                <button class="bg-blue-600 text-white text-xs px-2.5 py-1 rounded shadow-sm">Area</button>
                <button class="border border-gray-300 text-gray-600 text-xs px-2.5 py-1 rounded hover:bg-gray-50">Donut</button>
            </div>
        </div>
        <div class="h-64 flex items-center justify-center text-gray-400 text-sm italic">
            Sales Chart Area
        </div>
    </div>

    <div class="bg-blue-500 rounded border border-blue-600 shadow-sm p-4 text-white">
        <div class="flex justify-between items-center pb-3 border-b border-blue-400/50">
            <h2 class="font-semibold flex items-center gap-2 text-sm">
                <i data-lucide="map-pin" class="w-4 h-4"></i> Visitors
            </h2>
        </div>
        <div class="h-64 flex items-center justify-center text-blue-100 text-sm italic">
            Visitors Map Container
        </div>
    </div>
</div>

<!-- Products Inventory Table -->
<div class="bg-white rounded border border-gray-200 shadow-sm overflow-hidden mb-6">
    <div class="px-5 py-3 border-b border-gray-100 flex flex-wrap items-center justify-between gap-3">
        <h3 class="font-semibold text-gray-800 text-sm flex items-center gap-2">
            <i data-lucide="box" class="w-4 h-4 text-gray-500"></i> Product Inventory
        </h3>

        <div class="flex items-center gap-2">
            <span class="text-xs bg-emerald-50 text-emerald-700 px-2.5 py-0.5 rounded-full font-medium border border-emerald-200">
                Live from Database
            </span>
            <a href="/api/productsapi/download"
               class="bg-blue-600 hover:bg-blue-700 text-white text-xs font-medium px-3 py-1.5 rounded flex items-center gap-1.5 transition shadow-sm cursor-pointer">
                <i data-lucide="download" class="w-3.5 h-3.5"></i> Export JSON
            </a>
            <button type="button" onclick="openCreateModal()"
                    class="bg-blue-600 hover:bg-blue-700 text-white text-xs font-medium px-3 py-1.5 rounded flex items-center gap-1.5 transition shadow-sm cursor-pointer">
                <i data-lucide="plus" class="w-3.5 h-3.5"></i> Add Product
            </button>
        </div>
    </div>

    <div class="overflow-x-auto">
        <table class="w-full text-left border-collapse text-sm">
            <thead class="bg-gray-50 text-gray-500 text-xs font-semibold uppercase tracking-wider border-b border-gray-100">
                <tr>
                    <th class="py-3 px-5">ID</th>
                    <th class="py-3 px-5">Product Name</th>
                    <th class="py-3 px-5">Price</th>
                    <th class="py-3 px-5">Stock</th>
                    <th class="py-3 px-5">Date Added</th>
                    <th class="py-3 px-5 text-right">Actions</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-gray-100">
                @if (ViewBag.Products != null)
                {
                    foreach (var item in (List<AdminDashboard.Models.Product>)ViewBag.Products)
                    {
                        <tr id="product-row-@item.Id" class="hover:bg-gray-50 transition">
                            <td class="py-3 px-5 font-semibold text-gray-900">#@item.Id</td>
                            <td class="py-3 px-5 text-gray-700 font-medium">@item.Name</td>
                            <td class="py-3 px-5 font-medium text-gray-900">$@item.Price.ToString("F2")</td>
                            <td class="py-3 px-5">
                                <span class="px-2.5 py-0.5 text-xs rounded-full font-medium @(item.StockQuantity > 20 ? "bg-emerald-100 text-emerald-700" : "bg-rose-100 text-rose-700")">
                                    @item.StockQuantity in stock
                                </span>
                            </td>
                            <td class="py-3 px-5 text-gray-500 text-xs">@item.CreatedAt.ToString("MMM dd, yyyy")</td>
                            <td class="py-3 px-5 text-right">
                                <button type="button" onclick="deleteProduct(@item.Id, '@item.Name')"
                                        title="Delete product"
                                        class="text-red-500 hover:text-red-700 hover:bg-red-50 p-1.5 rounded transition cursor-pointer">
                                    <i data-lucide="trash-2" class="w-4 h-4"></i>
                                </button>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Create Product Modal (Inline Styles Enforce Fullscreen Viewport Overlay) -->
<div id="createModal" style="display: none; position: fixed; top: 0; left: 0; width: 100vw; height: 100vh; background-color: rgba(0, 0, 0, 0.65); z-index: 999999; align-items: center; justify-content: center; padding: 1rem; box-sizing: border-box;">
    <div style="background: #ffffff; border-radius: 0.75rem; width: 100%; max-width: 28rem; padding: 1.5rem; box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.25); position: relative;">
        <div style="display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid #e5e7eb; padding-bottom: 0.75rem;">
            <h3 style="font-size: 1rem; font-weight: 600; color: #111827; margin: 0;">Add New Product</h3>
            <button type="button" onclick="closeCreateModal()" style="color: #9ca3af; font-size: 1.5rem; line-height: 1; background: none; border: none; cursor: pointer;">
                &times;
            </button>
        </div>

        <div style="display: flex; flex-direction: column; gap: 1rem; margin-top: 1rem;">
            <div>
                <label style="display: block; font-size: 0.75rem; font-weight: 600; color: #374151; margin-bottom: 0.25rem;">Product Name</label>
                <input type="text" id="prodName" required placeholder="e.g. 4K Webcam"
                       style="width: 100%; font-size: 0.875rem; border: 1px solid #d1d5db; border-radius: 0.5rem; padding: 0.5rem 0.75rem; outline: none; box-sizing: border-box;" />
            </div>

            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem;">
                <div>
                    <label style="display: block; font-size: 0.75rem; font-weight: 600; color: #374151; margin-bottom: 0.25rem;">Price ($)</label>
                    <input type="number" step="0.01" min="0" id="prodPrice" required placeholder="89.99"
                           style="width: 100%; font-size: 0.875rem; border: 1px solid #d1d5db; border-radius: 0.5rem; padding: 0.5rem 0.75rem; outline: none; box-sizing: border-box;" />
                </div>
                <div>
                    <label style="display: block; font-size: 0.75rem; font-weight: 600; color: #374151; margin-bottom: 0.25rem;">Stock Quantity</label>
                    <input type="number" min="0" id="prodStock" required placeholder="25"
                           style="width: 100%; font-size: 0.875rem; border: 1px solid #d1d5db; border-radius: 0.5rem; padding: 0.5rem 0.75rem; outline: none; box-sizing: border-box;" />
                </div>
            </div>

            <div style="display: flex; justify-content: flex-end; gap: 0.5rem; padding-top: 0.75rem;">
                <button type="button" onclick="closeCreateModal()"
                        style="padding: 0.5rem 1rem; font-size: 0.75rem; font-weight: 500; color: #4b5563; background: #f3f4f6; border: none; border-radius: 0.5rem; cursor: pointer;">
                    Cancel
                </button>
                <button type="button" onclick="handleCreateProduct()"
                        style="padding: 0.5rem 1rem; font-size: 0.75rem; font-weight: 500; color: #ffffff; background: #2563eb; border: none; border-radius: 0.5rem; cursor: pointer;">
                    Save Product
                </button>
            </div>
        </div>
    </div>
</div>

<script>
    function openCreateModal() {
        var modal = document.getElementById('createModal');
        if (modal) {
            document.body.appendChild(modal);
            modal.style.display = 'flex';
        }
    }

    function closeCreateModal() {
        var modal = document.getElementById('createModal');
        if (modal) {
            modal.style.display = 'none';
        }
        var nameInput = document.getElementById('prodName');
        var priceInput = document.getElementById('prodPrice');
        var stockInput = document.getElementById('prodStock');

        if (nameInput) nameInput.value = '';
        if (priceInput) priceInput.value = '';
        if (stockInput) stockInput.value = '';
    }

    async function handleCreateProduct() {
        var nameEl = document.getElementById('prodName');
        var priceEl = document.getElementById('prodPrice');
        var stockEl = document.getElementById('prodStock');

        if (!nameEl || !priceEl || !stockEl) {
            alert('Error: Form input fields not found in DOM.');
            return;
        }

        const name = nameEl.value.trim();
        const price = parseFloat(priceEl.value);
        const stock = parseInt(stockEl.value, 10);

        if (!name) {
            alert('Please enter a product name.');
            return;
        }
        if (isNaN(price) || price < 0) {
            alert('Please enter a valid price.');
            return;
        }
        if (isNaN(stock) || stock < 0) {
            alert('Please enter a valid stock quantity.');
            return;
        }

        const payload = {
            name: name,
            price: price,
            stockQuantity: stock
        };

        try {
            const response = await fetch('/api/productsapi', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'Accept': 'application/json'
                },
                body: JSON.stringify(payload)
            });

            if (response.ok) {
                closeCreateModal();
                window.location.reload();
            } else {
                const text = await response.text();
                alert('Server returned error (' + response.status + '): ' + text);
            }
        } catch (error) {
            console.error('Fetch error:', error);
            alert('Request failed: ' + error.message);
        }
    }

    async function deleteProduct(id, name) {
        if (!confirm('Are you sure you want to delete "' + name + '"?')) {
            return;
        }

        try {
            const response = await fetch('/api/productsapi/' + id, {
                method: 'DELETE'
            });

            if (response.ok) {
                const row = document.getElementById('product-row-' + id);
                if (row) {
                    row.remove();
                }
            } else {
                const err = await response.text();
                alert('Error deleting: ' + err);
            }
        } catch (error) {
            console.error('Fetch error:', error);
            alert('Failed to delete product.');
        }
    }

    if (typeof lucide !== 'undefined') {
        lucide.createIcons();
    }
</script>